{
  "openapi": "3.2.0",
  "$self": "openapi.json",
  "info": {
    "title": "github-cdn",
    "summary": "GitHub as a content-addressed object store, over HTTP.",
    "description": "Creates repos, stores files as content-addressed objects, snapshots branches without cloning, deletes objects, and manages branches - all through the GitHub Git Data API via Octokit. See the project README for the object model rationale.",
    "version": "1.0.0",
    "license": { "name": "MIT" }
  },
  "servers": [
    { "url": "..", "description": "Function root, relative to where this document is served (/docs/openapi.json)" }
  ],
  "tags": [
    { "name": "Repositories", "summary": "Create and inspect repos" },
    { "name": "Objects", "summary": "Content-addressed file storage" },
    { "name": "Branches", "summary": "Branch creation" },
    { "name": "App", "summary": "Same operations as Repositories/Objects/Branches, authenticated as the GitHub App installation instead of a caller token" },
    { "name": "Setup", "summary": "Bootstrap a GitHub App for an org" },
    { "name": "Login", "summary": "Self-serve OAuth login: exchange GitHub login for an ordinary token usable at /github" },
    { "name": "Meta", "summary": "Health and service metadata" }
  ],
  "security": [{ "githubToken": [] }],
  "components": {
    "securitySchemes": {
      "githubToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "GitHub personal access token",
        "description": "Sent as `Authorization: Bearer <token>`. Forwarded directly to the GitHub API via Octokit; never stored past the lifetime of the warm function instance."
      },
      "accessSecret": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Shared secret (APP_ACCESS_SECRET)",
        "description": "Sent as `Authorization: Bearer <secret>`. /app authenticates to GitHub as the app installation itself, so there's no caller-supplied GitHub token to double as authorization the way there is for /github - this shared secret is the substitute."
      }
    },
    "parameters": {
      "owner": {
        "name": "owner",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "example": "dash-xd"
      },
      "repo": {
        "name": "repo",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "example": "my-app-a82f91cd"
      },
      "branch": {
        "name": "branch",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "example": "main"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or malformed `Authorization: Bearer <token>` header.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "BadRequest": {
        "description": "Malformed request body or parameters.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" }
        }
      },
      "Repo": {
        "type": "object",
        "required": ["name", "owner", "url", "default_branch"],
        "properties": {
          "name": { "type": "string", "example": "my-app-a82f91cd" },
          "owner": { "type": "string", "example": "dash-xd" },
          "url": { "type": "string", "format": "uri" },
          "default_branch": { "type": "string", "example": "main" }
        }
      },
      "StoredObject": {
        "type": "object",
        "required": ["objectId", "path", "size"],
        "properties": {
          "objectId": {
            "type": "string",
            "description": "SHA-256 of the raw file bytes.",
            "example": "a3f5c9d8e9f0"
          },
          "path": {
            "type": "string",
            "description": "Content-addressed storage path: objects/<hash prefix>/<hash>.",
            "example": "objects/a3/a3f5c9d8e9f0"
          },
          "name": {
            "type": ["string", "null"],
            "description": "Original filename, informational only - never affects storage location.",
            "example": "example.tar.gz"
          },
          "contentType": {
            "type": ["string", "null"],
            "example": "application/gzip"
          },
          "size": { "type": "integer", "example": 1048576 }
        }
      },
      "UploadResult": {
        "type": "object",
        "required": ["repo", "branch", "commit", "objects"],
        "properties": {
          "repo": { "type": "string" },
          "branch": { "type": "string" },
          "commit": { "type": "string", "description": "Git commit SHA that wrote these objects." },
          "objects": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/StoredObject" }
          }
        }
      },
      "TreeEntry": {
        "type": "object",
        "required": ["path", "mode", "type", "sha"],
        "properties": {
          "path": { "type": "string" },
          "mode": { "type": "string", "example": "100644" },
          "type": { "type": "string", "enum": ["blob"] },
          "sha": { "type": "string" },
          "size": { "type": "integer" },
          "url": { "type": "string", "format": "uri" },
          "encoding": {
            "type": "string",
            "enum": ["base64"],
            "description": "Present only when the request set content=true."
          },
          "content": {
            "type": "string",
            "description": "Base64-encoded blob content, present only when the request set content=true."
          }
        }
      },
      "BranchResult": {
        "type": "object",
        "required": ["repo", "branch", "commit"],
        "properties": {
          "repo": { "type": "string" },
          "branch": { "type": "string" },
          "commit": { "type": "string" }
        }
      },
      "BranchFromResult": {
        "type": "object",
        "required": ["repo", "branch", "from", "sha"],
        "properties": {
          "repo": { "type": "string" },
          "branch": { "type": "string" },
          "from": { "type": "string" },
          "sha": { "type": "string" }
        }
      },
      "DeleteResult": {
        "type": "object",
        "required": ["repo", "branch", "commit"],
        "properties": {
          "repo": { "type": "string" },
          "branch": { "type": "string" },
          "commit": { "type": "string" }
        }
      },
      "AppCredentials": {
        "type": "object",
        "description": "Returned exactly once by the manifest callback - not stored anywhere by this service.",
        "properties": {
          "id": { "type": "integer", "description": "GITHUB_APP_ID" },
          "slug": { "type": "string" },
          "client_id": { "type": "string" },
          "client_secret": { "type": "string" },
          "webhook_secret": { "type": "string" },
          "pem": { "type": "string", "description": "GITHUB_APP_PRIVATE_KEY - the app's private key." },
          "html_url": { "type": "string", "format": "uri" },
          "note": { "type": "string" }
        }
      },
      "Installation": {
        "type": "object",
        "properties": {
          "installationId": { "type": "integer", "description": "GITHUB_APP_INSTALLATION_ID" },
          "account": { "type": "string" },
          "targetType": { "type": "string", "enum": ["Organization", "User"] }
        }
      }
    }
  },
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "getHealth",
        "summary": "Liveness check",
        "tags": ["Meta"],
        "security": [],
        "responses": {
          "200": {
            "description": "Service is up.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": { "status": { "type": "string", "enum": ["ok"] } }
                },
                "examples": { "ok": { "value": { "status": "ok" } } }
              }
            }
          }
        }
      }
    },
    "/github/repos/{name}": {
      "post": {
        "operationId": "createRepo",
        "summary": "Create a repository",
        "description": "Creates a new GitHub repository named `<name>-<random8>` under the caller's own account (POST /user/repos). For an org-owned repo, see POST /github/repos/{org}/{name} instead.",
        "tags": ["Repositories"],
        "parameters": [
          { "name": "name", "in": "path", "required": true, "schema": { "type": "string" }, "example": "my-app" }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "private": { "type": "boolean", "default": true }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Repository created.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Repo" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/github/repos/{org}/{name}": {
      "post": {
        "operationId": "createOrgRepo",
        "summary": "Create a repository in an org",
        "description": "Creates a new GitHub repository named `<name>-<random8>` inside `:org`, via POST /orgs/{org}/repos rather than POST /user/repos. Works with any caller token that has org repo-creation rights - not just installation tokens; see POST /app/repos/{org}/{name} for the installation-auth equivalent of this same handler.",
        "tags": ["Repositories"],
        "parameters": [
          { "name": "org", "in": "path", "required": true, "schema": { "type": "string" }, "example": "dash-xd" },
          { "name": "name", "in": "path", "required": true, "schema": { "type": "string" }, "example": "my-app" }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "private": { "type": "boolean", "default": true }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Repository created.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Repo" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/github/repos/{owner}/{repo}/upload": {
      "post": {
        "operationId": "uploadObjects",
        "summary": "Upload files as content-addressed objects",
        "description": "Each uploaded file is hashed (SHA-256) and stored at `objects/<hash prefix>/<hash>`. Re-uploading identical bytes is idempotent, and duplicate content within one request is written once. Accepts any form field name(s) for file parts. See the README's Object model section.",
        "tags": ["Objects"],
        "parameters": [
          { "$ref": "#/components/parameters/owner" },
          { "$ref": "#/components/parameters/repo" },
          {
            "name": "branch",
            "in": "query",
            "required": false,
            "description": "Defaults to the repo's default branch. May also be sent as a `branch` form field instead.",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "contentMediaType": "application/octet-stream",
                    "description": "A file part. Repeat with any field name(s) to upload multiple files in one request."
                  },
                  "branch": { "type": "string" }
                }
              },
              "encoding": {
                "file": { "contentType": "application/octet-stream" }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Files stored.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UploadResult" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "413": {
            "description": "A file exceeded the 25MB upload limit.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/github/repos/{owner}/{repo}/{branch}": {
      "get": {
        "operationId": "getBranchSnapshot",
        "summary": "Snapshot a branch without cloning",
        "description": "Returns the branch's file tree via the Git Data API.",
        "tags": ["Repositories"],
        "parameters": [
          { "$ref": "#/components/parameters/owner" },
          { "$ref": "#/components/parameters/repo" },
          { "$ref": "#/components/parameters/branch" },
          {
            "name": "content",
            "in": "query",
            "required": false,
            "description": "Set to `true` to include each blob's base64 content.",
            "schema": { "type": "string", "enum": ["true", "false"], "default": "false" }
          }
        ],
        "responses": {
          "200": {
            "description": "Branch file tree.",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/TreeEntry" } }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "delete": {
        "operationId": "deleteObjects",
        "summary": "Delete one or more objects",
        "description": "Accepts raw tree paths (`path`/`paths`) or content-addressed object ids (`objectId`/`objectIds`).",
        "tags": ["Objects"],
        "parameters": [
          { "$ref": "#/components/parameters/owner" },
          { "$ref": "#/components/parameters/repo" },
          { "$ref": "#/components/parameters/branch" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": { "type": "string" },
                  "paths": { "type": "array", "items": { "type": "string" } },
                  "objectId": { "type": "string" },
                  "objectIds": { "type": "array", "items": { "type": "string" } }
                }
              },
              "examples": {
                "byObjectIds": { "value": { "objectIds": ["a3f5c9d8e9f0"] } },
                "byPath": { "value": { "paths": ["objects/a3/a3f5c9d8e9f0"] } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Objects deleted in a single commit.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeleteResult" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/github/repos/{owner}/{repo}/branches": {
      "post": {
        "operationId": "createEmptyBranch",
        "summary": "Create a new empty branch",
        "description": "An orphan commit with no tree entries and no parents.",
        "tags": ["Branches"],
        "parameters": [
          { "$ref": "#/components/parameters/owner" },
          { "$ref": "#/components/parameters/repo" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["branch"],
                "properties": { "branch": { "type": "string", "example": "empty-branch" } }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Branch created.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BranchResult" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/github/repos/{owner}/{repo}/branches/from": {
      "post": {
        "operationId": "createBranchFrom",
        "summary": "Create a branch from an existing branch",
        "tags": ["Branches"],
        "parameters": [
          { "$ref": "#/components/parameters/owner" },
          { "$ref": "#/components/parameters/repo" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["branch", "source"],
                "properties": {
                  "branch": { "type": "string", "example": "feature" },
                  "source": { "type": "string", "example": "main" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Branch created.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BranchFromResult" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/app/repos/{org}/{name}": {
      "post": {
        "operationId": "appCreateOrgRepo",
        "summary": "Create a repository in an org, as the app",
        "description": "Identical behavior to POST /github/repos/{org}/{name} - same handler, different auth. Installation tokens have no \"authenticated user\" to create a personal repo under, so this is the only repo-creation shape available on /app.",
        "tags": ["App"],
        "security": [{ "accessSecret": [] }],
        "parameters": [
          { "name": "org", "in": "path", "required": true, "schema": { "type": "string" }, "example": "dash-xd" },
          { "name": "name", "in": "path", "required": true, "schema": { "type": "string" }, "example": "my-app" }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "private": { "type": "boolean", "default": true }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Repository created.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Repo" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/app/repos/{owner}/{repo}/upload": {
      "post": {
        "operationId": "appUploadObjects",
        "summary": "Upload files as content-addressed objects, as the app",
        "description": "Identical behavior to POST /github/repos/{owner}/{repo}/upload - same handler, different auth.",
        "tags": ["App"],
        "security": [{ "accessSecret": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/owner" },
          { "$ref": "#/components/parameters/repo" },
          {
            "name": "branch",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "contentMediaType": "application/octet-stream" },
                  "branch": { "type": "string" }
                }
              },
              "encoding": {
                "file": { "contentType": "application/octet-stream" }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Files stored.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UploadResult" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "413": {
            "description": "A file exceeded the 25MB upload limit.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/app/repos/{owner}/{repo}/{branch}": {
      "get": {
        "operationId": "appGetBranchSnapshot",
        "summary": "Snapshot a branch without cloning, as the app",
        "description": "Identical behavior to GET /github/repos/{owner}/{repo}/{branch} - same handler, different auth.",
        "tags": ["App"],
        "security": [{ "accessSecret": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/owner" },
          { "$ref": "#/components/parameters/repo" },
          { "$ref": "#/components/parameters/branch" },
          {
            "name": "content",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["true", "false"], "default": "false" }
          }
        ],
        "responses": {
          "200": {
            "description": "Branch file tree.",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/TreeEntry" } }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "delete": {
        "operationId": "appDeleteObjects",
        "summary": "Delete one or more objects, as the app",
        "description": "Identical behavior to DELETE /github/repos/{owner}/{repo}/{branch} - same handler, different auth.",
        "tags": ["App"],
        "security": [{ "accessSecret": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/owner" },
          { "$ref": "#/components/parameters/repo" },
          { "$ref": "#/components/parameters/branch" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": { "type": "string" },
                  "paths": { "type": "array", "items": { "type": "string" } },
                  "objectId": { "type": "string" },
                  "objectIds": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Objects deleted in a single commit.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeleteResult" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/app/repos/{owner}/{repo}/branches": {
      "post": {
        "operationId": "appCreateEmptyBranch",
        "summary": "Create a new empty branch, as the app",
        "description": "Identical behavior to POST /github/repos/{owner}/{repo}/branches - same handler, different auth.",
        "tags": ["App"],
        "security": [{ "accessSecret": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/owner" },
          { "$ref": "#/components/parameters/repo" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["branch"],
                "properties": { "branch": { "type": "string", "example": "empty-branch" } }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Branch created.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BranchResult" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/app/repos/{owner}/{repo}/branches/from": {
      "post": {
        "operationId": "appCreateBranchFrom",
        "summary": "Create a branch from an existing branch, as the app",
        "description": "Identical behavior to POST /github/repos/{owner}/{repo}/branches/from - same handler, different auth.",
        "tags": ["App"],
        "security": [{ "accessSecret": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/owner" },
          { "$ref": "#/components/parameters/repo" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["branch", "source"],
                "properties": {
                  "branch": { "type": "string", "example": "feature" },
                  "source": { "type": "string", "example": "main" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Branch created.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BranchFromResult" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/setup": {
      "get": {
        "operationId": "serveManifestForm",
        "summary": "Start GitHub App creation for an org",
        "description": "Renders a page that auto-submits GitHub's app-manifest form. Requires PUBLIC_BASE_URL to be configured server-side so redirect_url can be built correctly.",
        "tags": ["Setup"],
        "security": [],
        "parameters": [
          { "name": "org", "in": "query", "required": true, "schema": { "type": "string" }, "example": "dash-xd" }
        ],
        "responses": {
          "200": {
            "description": "An HTML page that auto-submits to github.com/organizations/{org}/settings/apps/new.",
            "content": { "text/html": { "schema": { "type": "string" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": {
            "description": "PUBLIC_BASE_URL is not configured.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/setup/callback": {
      "get": {
        "operationId": "handleManifestCallback",
        "summary": "Exchange the manifest flow's code for app credentials",
        "description": "GitHub redirects here after the operator confirms app creation. Returns the new app's credentials exactly once - copy them into GITHUB_APP_ID / GITHUB_APP_PRIVATE_KEY and redeploy.",
        "tags": ["Setup"],
        "security": [],
        "parameters": [
          { "name": "code", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "The new app's credentials.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AppCredentials" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/setup/installations": {
      "get": {
        "operationId": "listInstallations",
        "summary": "List this app's installations",
        "description": "App-level (JWT) auth only, no installation id required - use this to find GITHUB_APP_INSTALLATION_ID once GITHUB_APP_ID/GITHUB_APP_PRIVATE_KEY are set.",
        "tags": ["Setup"],
        "security": [],
        "responses": {
          "200": {
            "description": "Installations of this app.",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Installation" } }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/login": {
      "get": {
        "operationId": "serveLoginPage",
        "summary": "Self-serve login page",
        "description": "Static page with a \"log in with GitHub\" link (OAuth user-to-server authorize redirect) and an \"install the app\" link. Sets a short-lived HttpOnly state cookie for CSRF protection on the callback.",
        "tags": ["Login"],
        "security": [],
        "responses": {
          "200": {
            "description": "An HTML page linking to GitHub's OAuth authorize URL and the app's install URL.",
            "content": { "text/html": { "schema": { "type": "string" } } }
          },
          "500": {
            "description": "GITHUB_APP_CLIENT_ID, PUBLIC_BASE_URL, GITHUB_APP_ID, or GITHUB_APP_PRIVATE_KEY is not configured.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/login/callback": {
      "get": {
        "operationId": "handleLoginCallback",
        "summary": "OAuth callback: exchange the code for the user's own token",
        "description": "GitHub redirects here after the user authorizes. Validates state against the cookie /login set, then exchanges the code for a user access token (needs GITHUB_APP_CLIENT_SECRET, hence server-side only). Redirects back to /login with the token in the URL fragment - never sent to a server or logged - for the page's script to read. That token is an ordinary GitHub token, used directly against /github.",
        "tags": ["Login"],
        "security": [],
        "parameters": [
          { "name": "code", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "state", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "error", "in": "query", "required": false, "description": "Set by GitHub if the user declined authorization.", "schema": { "type": "string" } }
        ],
        "responses": {
          "302": {
            "description": "Redirect to /login#access_token=...&scope=... on success, or /login#error=... on failure."
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": {
            "description": "PUBLIC_BASE_URL is not configured.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    }
  }
}
